{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(node -p 'JSON.parse(require(\"node:fs\").readFileSync(0, \"utf8\")).tool_input?.file_path ?? \"\"') && [ -n \"$f\" ] && \"$CLAUDE_PROJECT_DIR/node_modules/.bin/oxfmt\" --no-error-on-unmatched-pattern \"$f\" >/dev/null 2>&1 || true",
            "statusMessage": "oxfmt"
          }
        ]
      }
    ]
  }
}
