{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; [ -n \"$f\" ] && \"$CLAUDE_PROJECT_DIR/node_modules/.bin/oxfmt\" --no-error-on-unmatched-pattern \"$f\"; } >/dev/null 2>&1 || true",
            "statusMessage": "oxfmt"
          }
        ]
      }
    ]
  }
}
