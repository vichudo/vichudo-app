# Copy this file to `.env` and fill in the values. `.env` is gitignored; this
# file is committed, so never put secrets here.
#
# Every variable is validated by the schema in `src/env.js`: add new ones there
# too.

# Auth.js — generate a secret with `npx auth secret`.
# https://authjs.dev/getting-started/deployment#auth_secret
AUTH_SECRET=""

# Discord OAuth app: https://discord.com/developers/applications
# Callback URL: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# PostgreSQL. `./start-database.sh` starts a local one that matches this URL.
DATABASE_URL="postgresql://postgres:password@localhost:5432/t3-latest"
