# Copy this file to `.env` and fill in the values. `.env` is gitignored; this
# file is committed, so never put secrets here.
#
# Every variable is validated by the schema in `src/env.js`: add new ones there
# too.

# Better Auth — generate a secret with `pnpm auth:secret`.
# https://www.better-auth.com/docs/installation#set-environment-variables
BETTER_AUTH_SECRET=""
# The app's public URL. Optional locally; set it in production.
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional): leave empty to offer email and password only.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with the redirect URI http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# PostgreSQL. `pnpm db:dev` (no Docker) or `./start-database.sh` (Docker)
# starts a local one.
DATABASE_URL="postgresql://postgres:password@localhost:5432/t3-latest"
