# `pnpm env:init` copies this file to `.env` with a fresh BETTER_AUTH_SECRET.
# `.env` is gitignored; this file is committed, so never put secrets here.
# The app's variables are validated by `src/env.js`: add new ones there too.

# Better Auth. Generate a secret by hand with `pnpm auth:secret`.
BETTER_AUTH_SECRET=""
# The app's public URL. Set it to the real URL in production.
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional): leave empty to offer email and password only.
# See README → Turn on Google sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# PostgreSQL. These match `pnpm db:dev`, a local database with no Docker.
# Any PostgreSQL URL works instead (Docker, Neon, Supabase…).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# `pnpm db:dev`'s scratch database for `prisma migrate dev`. Delete this line
# (or leave it empty) when DATABASE_URL points elsewhere: Prisma then creates
# a scratch database itself.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
