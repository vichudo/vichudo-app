{
  "name": "vichudo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:generate": "auth generate --config src/server/auth.ts --adapter prisma --dialect postgresql --output prisma/auth.generated.prisma --yes",
    "auth:secret": "auth secret",
    "build": "next build",
    "check": "oxfmt --check && oxlint && pnpm typecheck && vitest run",
    "db:deploy": "prisma contract emit && prisma db migrate",
    "db:dev": "prisma7 dev --name vichudo-app --port 51213 --db-port 51214 --shadow-db-port 51215",
    "db:generate": "prisma contract emit",
    "db:migrate": "prisma contract emit && prisma db migrate --advance-ref db",
    "db:plan": "prisma contract emit && prisma migration plan",
    "db:push": "prisma contract emit && prisma db update",
    "db:studio": "prisma7 studio",
    "dev": "next dev",
    "env:init": "node scripts/env-init.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "prisma contract emit",
    "prepare": "husky",
    "preview": "next build && next start",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "cross-env SKIP_ENV_VALIDATION=1 next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/orm-postgres": "8.0.0-rc.18",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.104.5",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "superjson": "^2.2.6",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "^16.4.2",
    "@prisma/prisma7": "7.10.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "auth": "^1.7.12",
    "cross-env": "^10.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "postcss": "^8.5.31",
    "prisma": "8.0.0-rc.24",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,css,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "pnpm@12.14.0"
}
