# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# prisma generated client (regenerated by `postinstall`)
/src/generated

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files: commit only `.env.example`
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# editors
.idea

# claude code: machine-local, and `worktrees/` holds full copies of the repo.
# Tracked on purpose: the shared hooks (`settings.json`) and dev-server config
# (`launch.json`).
.claude/*
!.claude/settings.json
!.claude/launch.json
